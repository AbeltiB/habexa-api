# ── Database (Supabase PostgreSQL) ─────────────────────────────────────────────
# IMPORTANT: Supabase's direct connection host (db.<ref>.supabase.co) resolves
# IPv6-only. If your network/host has no IPv6 route (common on plain home/office
# connections and some PaaS), Prisma will hang or fail with P1001. Use the
# connection pooler instead — Supabase dashboard: Project Settings > Database >
# Connection string > "Session pooler" tab (IPv4, supports the session-level
# features `prisma db push`/`migrate` need). The "Transaction pooler" (port 6543)
# is fine for the running app's normal queries but can hang on migrate commands.
# URL-encode any special characters in the password (e.g. @ -> %40).
DATABASE_URL=postgresql://postgres.your-project-ref:password@aws-0-region.pooler.supabase.com:5432/postgres

# ── Redis (Upstash) ────────────────────────────────────────────────────────────
UPSTASH_REDIS_URL=rediss://default:token@host.upstash.io:6379

# ── Auth ───────────────────────────────────────────────────────────────────────
JWT_SECRET=minimum-32-character-random-secret-here
ADMIN_SECRET=separate-admin-dashboard-secret-here

# ── Telegram Login Widget (default sign-in) ────────────────────────────────────
# Create a bot with @BotFather, then set its domain: /setdomain -> your web app's domain
# TELEGRAM_BOT_USERNAME (no @) is also needed by habexa-web as NEXT_PUBLIC_TELEGRAM_BOT_USERNAME
TELEGRAM_BOT_TOKEN=123456:your-bot-token-from-botfather

# ── Google Sign-In ──────────────────────────────────────────────────────────────
# console.cloud.google.com -> APIs & Services -> Credentials -> OAuth client ID (Web)
# Same client ID is also needed by habexa-web/habexa-admin as NEXT_PUBLIC_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# ── Afro SMS (OTP delivery — also used to verify a linked phone number) ────────
# All 4 values are provided by Afro SMS when you register
AFROSMS_TOKEN=your-afrosms-bearer-token
AFROSMS_OTP_URL=https://api.afrosms.com/v1/send  # or your custom OTP endpoint
AFROSMS_OTP_FROM=HABEXA                           # short sender code/number
AFROSMS_OTP_SENDER=Habexa                         # display name shown to recipient

# ── Email (Nodemailer / SMTP) ──────────────────────────────────────────────────
# Works with any SMTP provider: Gmail, Outlook, custom server
# Gmail: enable "App Passwords" or use OAuth2 (recommended for production)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false                                 # true for port 465 (SSL)
SMTP_USER=your@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=Habexa <noreply@habexa.com>
ADMIN_EMAIL=admin@habexa.com                      # admin notification recipient

# ── ImageKit (media storage & delivery) ────────────────────────────────────────
# Sign up at https://imagekit.io — free tier is generous
IMAGEKIT_PUBLIC_KEY=public_xxxxxxxxxxxxxxxxxxxx
IMAGEKIT_PRIVATE_KEY=private_xxxxxxxxxxxxxxxxxxxx
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your-id

# ── YouTube (video hosting — optional) ────────────────────────────────────────
# Setup: Google Cloud Console → Create project → Enable YouTube Data API v3
# → Create OAuth2 credentials → Run one-time auth flow to get refresh token
# See: https://developers.google.com/youtube/v3/guides/auth/server-side-web-apps
YOUTUBE_CLIENT_ID=your-google-oauth-client-id
YOUTUBE_CLIENT_SECRET=your-google-oauth-client-secret
YOUTUBE_REFRESH_TOKEN=your-one-time-authorized-refresh-token

# ── Web Push (VAPID) ──────────────────────────────────────────────────────────
# Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_SUBJECT=mailto:admin@habexa.com

# ── App ────────────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=8080
API_URL=https://api.habexa.com
WEB_URL=https://habexa.com

# ── Manual bank transfer (launch payment rail — see PRD D-02) ─────────────────
# Shown to users in the subscription upgrade flow; falls back to a generic
# "contact support" message if left blank.
BANK_NAME=
BANK_ACCOUNT_NAME=
BANK_ACCOUNT_NUMBER=

# ── Telebirr / CBE Birr (Phase 2 — leave blank until needed) ──────────────────
TELEBIRR_APP_ID=
TELEBIRR_API_KEY=
